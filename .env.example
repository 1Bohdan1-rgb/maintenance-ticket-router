# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me

# Database
# Local dev defaults to SQLite. On Render (or any host with an ephemeral
# filesystem), set this to a persistent Postgres connection string instead,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///tickets.db

# Claude API (used by ai_classifier.py to classify tickets on creation)
ANTHROPIC_API_KEY=

# SMTP (same variables as PrepHire; used to send ticket confirmation emails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Admin auth (protects PATCH/DELETE admin endpoints + the /dashboard pages).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without this set, every protected endpoint refuses all requests (fails
# closed) rather than staying open.
ADMIN_TOKEN=
